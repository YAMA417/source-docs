      "summary": "購入者が注文を確定すると、Stripe に支払いを作り、注文を保存して領収書の送信を予約する。",
      "start": "注文確認画面のボタン",
      "end": "注文を返して商品一覧へ戻る",
      "preconditions": [
        {"kind": "authentication", "description": "認証は無い", "evidence": ["src/app/api/orders/route.ts"]}
      ],
      "inputs": [{"name": "productId", "type": "number", "required": true, "constraints": "必須", "source": "リクエストボディ"}],
      "validations": [{"condition": "productId が無い", "onInvalid": "400 を返す", "userVisible": "エラー"}],
      "sequence": {
        "participants": [
          {"id": "user", "label": "購入者", "kind": "user"},
