          {"id": "api", "label": "POST /api/orders", "kind": "backend"},
          {"id": "stripe", "label": "Stripe", "kind": "external"},
          {"id": "db", "label": "DB", "kind": "db"},
          {"id": "queue", "label": "receipts キュー", "kind": "queue"}
        ],
        "steps": [
          {"from": "user", "to": "screen", "message": "注文を確定する"},
          {"from": "screen", "to": "api", "message": "POST /api/orders"},
          {"alt": [
            {"condition": "productId が無い", "steps": [{"from": "api", "to": "screen", "message": "400", "kind": "return"}]},
            {"condition": "productId がある", "steps": [
              {"from": "api", "to": "stripe", "message": "支払いを作る"},
              {"from": "stripe", "to": "api", "message": "PaymentIntent", "kind": "return"},
              {"from": "api", "to": "db", "message": "orders に INSERT"},
              {"from": "api", "to": "queue", "message": "send-receipt", "kind": "async"},
              {"from": "api", "to": "screen", "message": "201 注文", "kind": "return"}
            ]}
          ]}
        ]
      },
      "branches": [{"condition": "productId が無い", "result": "処理を止める", "status": 400, "userVisible": "エラー"}],
      "dataImpact": [
        {"table": "table:orders", "operation": "CREATE", "columns": ["product_id", "payment_intent_id"], "meaning": "注文を作る", "evidence": ["src/services/orders.ts"]}
      ],
